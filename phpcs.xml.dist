<?xml version="1.0"?>
<ruleset name="Auto CSP Manager">
	<description>WordPress coding standards for Auto CSP Manager.</description>

	<file>auto-csp-manager.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!-- The plugin ships no Composer autoloader; files are required by hand. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="auto-csp-manager"/>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.8"/>
</ruleset>
