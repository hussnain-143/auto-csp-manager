<?xml version="1.0"?>
<!--
	Unit suite: the CSP engine, report normalisation and markup extraction.
	Pure logic, run against a stub layer - no WordPress, no database.
	The integration suite has its own config: phpunit-integration.xml.dist
-->
<phpunit
	bootstrap="tests/bootstrap-unit.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnWarning="true"
	failOnRisky="true">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
